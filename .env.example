# Backend
BRAIN_ENVIRONMENT=development
BRAIN_DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain
BRAIN_CORS_ORIGINS=http://localhost:3000
BRAIN_APP_SECRET=replace-me-with-a-random-secret
BRAIN_WORKOS_CLIENT_ID=
BRAIN_WORKOS_AUDIENCE=
BRAIN_AWS_REGION=us-east-1
BRAIN_SECRETS_PREFIX=brain

# Slack app-level configuration. Inject secret values through your deployment secret manager.
BRAIN_SLACK_CLIENT_ID=
BRAIN_SLACK_CLIENT_SECRET=
BRAIN_SLACK_SIGNING_SECRET=
BRAIN_SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/oauth/callback

# GitHub App configuration. The app private key, OAuth client secret and webhook secret
# live together in AWS Secrets Manager at BRAIN_GITHUB_APP_SECRET_REF, not in this file.
# Expected secret keys: private_key_pem, client_secret, webhook_secret.
BRAIN_GITHUB_APP_ID=
BRAIN_GITHUB_APP_SLUG=
BRAIN_GITHUB_CLIENT_ID=
BRAIN_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/oauth/callback
BRAIN_GITHUB_APP_SECRET_REF=

# Provider-neutral embedding endpoint. It accepts JSON {model, input[]} and returns
# either {data:[{embedding:[...]}]} or {embeddings:[[...]]}. If authentication is
# required, store {"api_key":"..."} in AWS Secrets Manager and set the ARN below.
BRAIN_EMBEDDING_API_URL=
BRAIN_EMBEDDING_MODEL=
BRAIN_EMBEDDING_SECRET_REF=
BRAIN_EMBEDDING_TIMEOUT_SECONDS=8

# Governed AI gateway. In production, every configured provider hostname must appear
# in this comma-separated egress allowlist. Provider API keys themselves are stored
# through AWS Secrets Manager by the AI provider configuration API, never here.
BRAIN_AI_PROVIDER_ALLOWED_HOSTS=
BRAIN_AI_PROVIDER_TIMEOUT_SECONDS=30

# Production observability. Metrics expose route/provider aggregate telemetry only;
# they deliberately do not use organisation/user IDs as Prometheus labels. Production
# metrics require a bearer token and should additionally be restricted at the ingress.
# OTLP export is optional; production OTLP endpoints must use HTTPS.
BRAIN_LOG_LEVEL=INFO
BRAIN_METRICS_ENABLED=true
BRAIN_METRICS_BEARER_TOKEN=
BRAIN_OTEL_SERVICE_NAME=brain-api
BRAIN_OTEL_EXPORTER_OTLP_ENDPOINT=

# AWS credentials are supplied through the standard AWS SDK credential chain.
# Never commit AWS keys, OAuth tokens, refresh tokens, API keys, signing secrets, or customer data here.

# Frontend / WorkOS AuthKit. Keep WORKOS_API_KEY and WORKOS_COOKIE_PASSWORD server-only.
# WORKOS_COOKIE_PASSWORD must be a strong random value of at least 32 characters.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Brain API is called from Next.js server components/BFF routes. Do not expose the
# WorkOS access token to browser code. Production BRAIN_API_BASE_URL must be HTTPS.
BRAIN_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BRAIN_API_URL=http://localhost:8000
