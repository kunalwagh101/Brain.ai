FROM python:3.12-slim AS staging

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
COPY alembic.ini ./
COPY migrations ./migrations
COPY tests ./tests

RUN pip install --upgrade pip && pip install ".[dev]"

# Fail the Render build before deployment if the retrieval slice has an
# avoidable lint or portable-unit regression. Real PostgreSQL/pgvector
# execution happens again at service start after migrations reach head.
RUN ruff check \
      app/search.py \
      app/search_models.py \
      app/routes/search.py \
      tests/conftest.py \
      tests/test_search.py \
      tests/test_search_evaluation.py \
      tests/test_search_contract.py \
      migrations/versions/20260907_0009_permission_aware_search.py \
    && pytest -q \
      tests/test_search.py \
      tests/test_search_evaluation.py \
      tests/test_search_contract.py

RUN addgroup --system brain && adduser --system --ingroup brain brain
USER brain

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
