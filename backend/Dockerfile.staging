FROM python:3.12-slim AS staging

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
COPY alembic.ini ./
COPY migrations ./migrations
COPY tests ./tests
COPY run_acceptance_chain.py ./run_acceptance_chain.py

RUN pip install --upgrade pip && pip install ".[dev]"

# Portable pre-deploy evidence. The ordered runner starts with S-05.01 and
# stops immediately on the first failing story, so downstream stories cannot
# acquire misleading backend PASS markers when an upstream contract fails.
# Real PostgreSQL/pgvector execution runs again at service start after the
# staging database is migrated to head.
RUN python run_acceptance_chain.py \
      --lint \
      --report /tmp/brain-acceptance-portable.json

RUN addgroup --system brain && adduser --system --ingroup brain brain
USER brain

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
